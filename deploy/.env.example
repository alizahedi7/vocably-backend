# Copy to /opt/vocably/.env on the VPS and fill in real values.
# This file is read by docker-compose.prod.yml and by the API container.

# Public hostname of the API (DNS A record must point at this VPS).
DOMAIN=api.example.com

# Postgres superuser password for the db container.
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing key. Generate: openssl rand -hex 32
SECRET_KEY=

# SMS OTP delivery (console just logs codes — use kavenegar in production).
OTP_SENDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Google sign-in (stub accepts fake tokens — use google in production).
GOOGLE_VERIFIER=google
GOOGLE_CLIENT_ID=

# Which image tag to run; the CD workflow always pushes "latest" plus the
# commit SHA, so pin a SHA here to roll back.
IMAGE_TAG=latest
