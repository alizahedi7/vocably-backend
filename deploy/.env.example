# Copy to /opt/vocably/.env on the VPS and fill in real values.
# This file is read by docker-compose.prod.yml and by the API container.

# Public hostname of the API (DNS A record must point at this VPS).
DOMAIN=api.example.com

# Public hostname of the PWA (built and rsynced here by the vocably-mobile
# repo, served by the same Caddy from /opt/vocably/web). Needs its own DNS A
# record pointing at this VPS.
WEB_DOMAIN=app.example.com

# Public hostname of the admin dashboard (vocably-admin), a container of its
# own on this VPS reached via host.docker.internal — see deploy/Caddyfile.
# Needs its own DNS A record pointing at this VPS. Optional: leave unset
# until the vocably-admin container is actually deployed.
ADMIN_DOMAIN=admin.example.com

# Comma-separated list of origins allowed to call this API from a browser
# (web/PWA clients only — native apps aren't subject to CORS). Empty means
# no CORS middleware is installed at all, which silently blocks every
# browser request with no server-side error. See app/main.py.
BACKEND_CORS_ORIGINS=

# Postgres superuser password for the db container.
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing key. Generate: openssl rand -hex 32
SECRET_KEY=

# SMS OTP delivery (console just logs codes — use sms_ir or kavenegar in production).
OTP_SENDER=sms_ir
SMS_IR_API_KEY=
# ID of the verify template configured in the sms.ir panel (must define a
# single "CODE" parameter)
SMS_IR_TEMPLATE_ID=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Google sign-in (stub accepts fake tokens — use google in production).
GOOGLE_VERIFIER=google
GOOGLE_CLIENT_ID=

# ── AI services ──────────────────────────────────────────────
# Undocumented here until 2026-08, which is why production ended up running
# GapGPT under variables named AVALAI_*. Give each gateway its own block; a
# *_BASE_URL pointed at somebody else's gateway makes the name lie in the logs
# and in every cached card's provenance.
#
# See .env.example at the repo root for the full annotated list.
AI_PROVIDER=avalai
AVALAI_API_KEY=
AVALAI_MODEL=gemini-3.5-flash-lite

# Ordered fallbacks, tried when the primary fails. Leave EMPTY unless the
# accounts named here are funded — a fallback pointing at an empty balance is
# worse than none, because it looks like resilience until the day it is needed.
AI_FALLBACK_PROVIDERS=
GAPGPT_API_KEY=
GAPGPT_MODEL=gemini-3.5-flash-lite

# ── Background tasks ─────────────────────────────────────────
# CELERY_BROKER_URL is set by docker-compose.prod.yml (redis://redis:6379/0)
# and does not belong here — it is fixed by the shape of the stack.

# UTC hour of the daily word_reviews partition-maintenance job.
REVIEW_HISTORY_MAINTENANCE_HOUR=3
# Whether that job also DROPS partitions past REVIEW_HISTORY_RETENTION_MONTHS.
# Off by default: expired months are reported in the worker log but never
# deleted. Turning this on makes a background job erase learners' review
# history irreversibly — enable it only as a deliberate retention policy.
REVIEW_HISTORY_AUTO_PRUNE=false
# How long raw review events are kept. 0 keeps everything forever.
REVIEW_HISTORY_RETENTION_MONTHS=24

# Which image tag to run; the CD workflow always pushes "latest" plus the
# commit SHA, so pin a SHA here to roll back.
IMAGE_TAG=latest
