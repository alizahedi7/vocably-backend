# Caddy obtains and renews the Let's Encrypt certificate for each site
# automatically; all it needs is ports 80+443 open and DNS pointing here.
{$DOMAIN} {
	# Response hardening for the API origin. The PWA block below sets its own
	# (and is mirrored from vocably-mobile's Caddyfile.web — edit it there);
	# this site had none at all, so every API response went out bare.
	header {
		# Caddy redirects 80→443 already, but that first plaintext request still
		# happens once per client. HSTS removes it for a year.
		#
		# Deliberately without `includeSubDomains` and `preload`: both are
		# effectively irreversible for a year of cached browser state, and this
		# file does not know whether {$DOMAIN} is an apex covering the PWA and
		# admin hosts. Add them once that is checked and every sibling host is
		# known to be HTTPS-only.
		Strict-Transport-Security "max-age=31536000"

		# JSON that a browser is free to re-interpret as HTML or a script is how
		# a reflected value in an error body becomes stored XSS.
		X-Content-Type-Options nosniff

		# No HTML is served here (see EXPOSE_DOCS — Swagger UI is off in
		# production), so framing has nothing to steal today. Both headers cost
		# nothing and stay correct if that ever changes.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"

		# An API URL can carry ids in its path; don't send them to third parties.
		Referrer-Policy no-referrer

		# Free version disclosure. Nothing legitimate reads it.
		-Server
	}

	reverse_proxy api:8000
}

# The PWA (vocably-mobile), a folder of static files rsynced to
# /opt/vocably/web by that repo's workflow and mounted read-only into this
# container. It is served here rather than by a second web server because
# this container owns 80/443 on the host.
#
# Keep this block in sync with vocably-mobile's deploy/Caddyfile.web, which
# is where it is documented.
{$WEB_DOMAIN} {
	root * /srv/vocably-web
	encode gzip zstd

	# NO single-page-app rewrite. The app has no URL routing, and a
	# catch-all to index.html would swallow /google_redirect.html — the page
	# Google returns the sign-in popup to.

	# Flutter's output filenames are stable across builds, so the entry
	# points must revalidate or users keep running the previous release.
	@entry path /index.html / /flutter_bootstrap.js /flutter_service_worker.js /version.json /manifest.json
	header @entry Cache-Control "no-cache, no-store, must-revalidate"

	header /canvaskit/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/fonts/* Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Deliberately NOT Cross-Origin-Opener-Policy "same-origin": that
		# severs window.opener, which is how the Google sign-in popup posts
		# its id_token back to the app.
	}

	file_server
}

# The admin dashboard (vocably-admin) — unlike the PWA above, this is a live
# Next.js server in its own container, not a folder of static files. It's a
# separate compose project on this same VPS, reached by its Compose service
# name ("admin") over vocably-net, the external network shared between the
# two projects (see docker-compose.prod.yml's `caddy` service and
# vocably-admin's docker-compose.admin.yml).
#
# Keep this block in sync with vocably-admin's deploy/Caddyfile.admin, which
# is where it is documented. Defaults to a reserved, never-resolvable
# hostname (RFC 2606) when ADMIN_DOMAIN is unset, so a VPS that hasn't been
# set up for the admin dashboard yet still starts cleanly — Caddy just fails
# ACME for that one site instead of refusing to start at all.
{$ADMIN_DOMAIN:admin.invalid} {
	reverse_proxy admin:3000
}
