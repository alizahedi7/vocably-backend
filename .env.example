# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=Vocably

# CORS: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security / JWT ────────────────────────────────────────────
# Generate a strong secret, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=vocably
POSTGRES_PASSWORD=vocably
POSTGRES_DB=vocably
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If DATABASE_URL is set it overrides the discrete POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://vocably:vocably@localhost:5432/vocably

# ── Auth adapters (dev stubs) ─────────────────────────────────
# OTP length and time-to-live (seconds)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# Minimum wait between OTP requests for the same phone (seconds)
OTP_RESEND_COOLDOWN_SECONDS=30
# In development the OTP sender logs the code to the console instead of sending SMS.
OTP_SENDER=console
# Google OAuth (dev stub verifies without contacting Google)
GOOGLE_VERIFIER=stub
GOOGLE_CLIENT_ID=

# ── AI services ───────────────────────────────────────────────
# stub = deterministic canned data (no external calls). Swap for a real provider later.
AI_PROVIDER=stub
