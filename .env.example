# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=Vocably

# CORS: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security / JWT ────────────────────────────────────────────
# Generate a strong secret, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=vocably
POSTGRES_PASSWORD=vocably
POSTGRES_DB=vocably
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If DATABASE_URL is set it overrides the discrete POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://vocably:vocably@localhost:5432/vocably

# ── Auth adapters (dev stubs) ─────────────────────────────────
# OTP length and time-to-live (seconds)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# Minimum wait between OTP requests for the same phone (seconds)
OTP_RESEND_COOLDOWN_SECONDS=30
# SMS cost-abuse backstop: OTP requests allowed per client IP per hour (<= 0 disables)
OTP_REQUESTS_PER_IP_PER_HOUR=20
# DEV/TEST ONLY: every phone number receives this exact code instead of a random
# one (must be OTP_LENGTH digits). Lets mobile/QA sign in without reading server
# logs. Leave empty for real random codes; startup fails if set with
# ENVIRONMENT=production.
OTP_FIXED_CODE=
# console = log the code instead of sending SMS (dev). kavenegar = real SMS via
# Kavenegar's Verify Lookup API. sms_ir = real SMS via sms.ir's Verify API.
OTP_SENDER=console
KAVENEGAR_API_KEY=
# Name of the verify template configured in the Kavenegar panel
KAVENEGAR_OTP_TEMPLATE=
SMS_IR_API_KEY=
# ID of the verify template configured in the sms.ir panel (must define a
# single "CODE" parameter)
SMS_IR_TEMPLATE_ID=
# stub = trust fake tokens (dev). google = validate id_tokens against Google's JWKS;
# GOOGLE_CLIENT_ID (the OAuth client id / token audience) is then required.
# Startup fails if left as "stub" with ENVIRONMENT=production.
GOOGLE_VERIFIER=stub
GOOGLE_CLIENT_ID=

# ── AI services ───────────────────────────────────────────────
# stub      = deterministic canned data, no external calls (default; used by tests).
# anthropic = real Claude lookups/stories. Requires ANTHROPIC_API_KEY.
# avalai    = real lookups/stories via AvalAI (https://avalai.ir), an
#             OpenAI-protocol gateway. Requires AVALAI_API_KEY and AVALAI_MODEL.
AI_PROVIDER=stub

# Never commit a real key — set it in the environment only.
ANTHROPIC_API_KEY=
# Model is config, not code: the right one changes faster than this repo does.
ANTHROPIC_MODEL=claude-opus-4-8
# Leave empty for api.anthropic.com. Set to route via a gateway that speaks the
# Anthropic protocol, e.g. ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_BASE_URL=
# JSON object of headers forced onto every provider request (overriding the SDK's
# own). Only needed by gateways that gate on a specific client, e.g.
# ANTHROPIC_EXTRA_HEADERS={"user-agent":"claude-cli/2.1.0 (external, cli)"}
ANTHROPIC_EXTRA_HEADERS=
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_TOKENS=4096

# Never commit a real key — set it in the environment only.
AVALAI_API_KEY=
# AvalAI's OpenAI-compatible base URL; only change to point at a different
# OpenAI-protocol gateway.
AVALAI_BASE_URL=https://api.avalai.ir/v1
# No default — pick the model name from AvalAI's own catalogue.
AVALAI_MODEL=
AVALAI_TIMEOUT_SECONDS=30
AVALAI_MAX_TOKENS=4096

# ── Review history ────────────────────────────────────────────
# `word_reviews` is partitioned by month. Partitions do not appear on their
# own — run `make partitions` on a schedule (a daily cron is plenty).
# How many months of partitions to keep ahead of today. The margin is what
# stops a lapsed maintenance job from ever reaching the DEFAULT partition.
REVIEW_HISTORY_PARTITION_LOOKAHEAD_MONTHS=12
# How long raw review events are kept before their partition is dropped by
# `make partitions prune=1`. 0 keeps everything forever.
REVIEW_HISTORY_RETENTION_MONTHS=24

# ── Background tasks (Celery) ─────────────────────────────────
# Broker for background/scheduled work. Inside docker compose this is
# redis://redis:6379/0; the default below suits a local `make worker`.
CELERY_BROKER_URL=redis://localhost:6379/0
# Where task results are stored. Empty = results are not stored at all, which
# is right while nothing reads a task's return value. Set it when something does.
CELERY_RESULT_BACKEND=
# Per-task limits, in seconds. Soft must be below hard: the soft limit raises an
# exception the task can clean up from, the hard one kills the worker process.
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540
CELERY_TASK_TIME_LIMIT_SECONDS=600

# UTC hour of the daily word_reviews partition-maintenance run.
REVIEW_HISTORY_MAINTENANCE_HOUR=3
# Whether that scheduled run also DROPS partitions past the retention window.
# Off by default — leaving it off means expired months are reported in the logs
# but never deleted. Turn it on only when the retention window above is a
# deliberate policy: it makes a background job delete history irreversibly.
REVIEW_HISTORY_AUTO_PRUNE=false

# ── Dictionary grounding ──────────────────────────────────────
# Front lookups with a free English dictionary and ask the model only to select
# and translate its senses, instead of recalling them from memory. Measured on
# our own prompts this cut input tokens ~60% and cost ~30%, and removed the
# invented senses the generative path produces for polysemous words like
# "bound" and "decline".
#
# Off by default: it changes what every card says, so it is a product decision,
# not a deployment detail. Turning it on also changes the lookup cache key, so
# existing cards are retired rather than mixed with grounded ones.
#
# It never becomes a dependency: the dictionary covers ~67% of real input (and
# 0% of typos), so a miss, timeout, 429 or 5xx falls through to full AI
# generation exactly as today.
DICTIONARY_ENABLED=false
# Hard ceiling on the dictionary call, in seconds. It sits in front of a path
# that already works without it, so being slow is worth less than giving up.
# Measured p95 is 325 ms.
DICTIONARY_TIMEOUT_SECONDS=1.0
# Where dictionary entries are cached. Defaults to the Celery broker's Redis on
# a separate logical database, so flushing this cache cannot touch queued tasks.
# Inside docker compose use redis://redis:6379/1.
DICTIONARY_REDIS_URL=redis://localhost:6379/1
# Entries are immutable facts about English shared by every learner, so they
# keep for a long time. This cache is the main defence against the API's rate
# limiting (it 429s under a burst), not a latency optimisation — it answers in
# ~27 ms. Deliberately NOT keyed by prompt version: Wiktionary's entry for
# "undermine" does not change when we edit a prompt.
DICTIONARY_CACHE_TTL_SECONDS=2592000
# Misses expire far sooner than hits: a word Wiktionary lacks today (new slang)
# may appear next month, and a 30-day negative cache would hide it.
DICTIONARY_CACHE_MISS_TTL_SECONDS=86400
# Whether the grounded path also rewrites each dictionary definition into
# learner-dictionary English, or shows the source wording as-is.
#
# Measured on 504 Essential Words lesson 1, gemini-3.5-flash-lite via GapGPT:
#
#   false (translate-only)  $0.27 / 504 words   0% of definitions obey the
#                                               card style rules
#   true  (rewrite)         $0.43 / 504 words   100% obey them
#
# Latency is identical either way (~8.5 s median), because the model's thinking
# time dominates, not the tokens it writes.
#
# `false` is the cheaper call — the model returns only Persian headlines and the
# English is joined back locally by sense index, so it cannot corrupt text it
# never writes. But the free dictionary is a Wiktionary mirror written for
# reference, not for learners: it produces card fronts like "To weaken or work
# against; to hinder, sabotage." — capitalised, semicolon-separated, trailing
# full stop, all of which the card style forbids.
#
# `true` costs 16 cents more across the entire book and fixes every one of them.
# Recommended on unless output tokens are genuinely the constraint.
DICTIONARY_REWRITE_DEFINITIONS=true

# ── Abuse protection ──────────────────────────────────────────────
# Shared store for the limits that are *security* controls rather than cost
# backstops: handle enumeration and invite-code guessing. The in-process
# limiter multiplies its budget by the worker count and resets on restart,
# which is fine for SMS spend and wrong for these two. An unreachable Redis
# degrades to per-worker — it never fails open.
# In the compose stack the host is the service name, not localhost.
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2

# Handle-availability checks per user per hour. Typed into as the learner
# types, so this is generous; it exists to stop the endpoint being walked as
# a handle-enumeration oracle, not to stop typing.
USERNAME_CHECKS_PER_USER_PER_HOUR=120

# People-searches per user per hour. Tighter than the check above: one call
# returns up to eight real handles rather than a yes/no about one guess, so
# walking the namespace with it is that many times cheaper. It is called on a
# debounce, so sharing a deck with a class never comes near this.
USER_SEARCHES_PER_USER_PER_HOUR=60

# Invite-code redemptions per user and per IP per hour. This is the one
# endpoint where guessing wins access to someone else's data.
JOINS_PER_USER_PER_HOUR=20
JOINS_PER_IP_PER_HOUR=60
