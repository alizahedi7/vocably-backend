# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME=Vocably

# CORS: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Security / JWT ────────────────────────────────────────────
# Generate a strong secret, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=vocably
POSTGRES_PASSWORD=vocably
POSTGRES_DB=vocably
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If DATABASE_URL is set it overrides the discrete POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://vocably:vocably@localhost:5432/vocably

# ── Auth adapters (dev stubs) ─────────────────────────────────
# OTP length and time-to-live (seconds)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# Minimum wait between OTP requests for the same phone (seconds)
OTP_RESEND_COOLDOWN_SECONDS=30
# SMS cost-abuse backstop: OTP requests allowed per client IP per hour (<= 0 disables)
OTP_REQUESTS_PER_IP_PER_HOUR=20
# DEV/TEST ONLY: every phone number receives this exact code instead of a random
# one (must be OTP_LENGTH digits). Lets mobile/QA sign in without reading server
# logs. Leave empty for real random codes; startup fails if set with
# ENVIRONMENT=production.
OTP_FIXED_CODE=
# console = log the code instead of sending SMS (dev). kavenegar = real SMS via
# Kavenegar's Verify Lookup API. sms_ir = real SMS via sms.ir's Verify API.
OTP_SENDER=console
KAVENEGAR_API_KEY=
# Name of the verify template configured in the Kavenegar panel
KAVENEGAR_OTP_TEMPLATE=
SMS_IR_API_KEY=
# ID of the verify template configured in the sms.ir panel (must define a
# single "CODE" parameter)
SMS_IR_TEMPLATE_ID=
# stub = trust fake tokens (dev). google = validate id_tokens against Google's JWKS;
# GOOGLE_CLIENT_ID (the OAuth client id / token audience) is then required.
# Startup fails if left as "stub" with ENVIRONMENT=production.
GOOGLE_VERIFIER=stub
GOOGLE_CLIENT_ID=

# ── AI services ───────────────────────────────────────────────
# stub      = deterministic canned data, no external calls (default; used by tests).
# anthropic = real Claude lookups/stories. Requires ANTHROPIC_API_KEY.
# avalai    = real lookups/stories via AvalAI (https://avalai.ir), an
#             OpenAI-protocol gateway. Requires AVALAI_API_KEY and AVALAI_MODEL.
AI_PROVIDER=stub

# Never commit a real key — set it in the environment only.
ANTHROPIC_API_KEY=
# Model is config, not code: the right one changes faster than this repo does.
ANTHROPIC_MODEL=claude-opus-4-8
# Leave empty for api.anthropic.com. Set to route via a gateway that speaks the
# Anthropic protocol, e.g. ANTHROPIC_BASE_URL=https://agentrouter.org
ANTHROPIC_BASE_URL=
# JSON object of headers forced onto every provider request (overriding the SDK's
# own). Only needed by gateways that gate on a specific client, e.g.
# ANTHROPIC_EXTRA_HEADERS={"user-agent":"claude-cli/2.1.0 (external, cli)"}
ANTHROPIC_EXTRA_HEADERS=
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_TOKENS=4096

# Never commit a real key — set it in the environment only.
AVALAI_API_KEY=
# AvalAI's OpenAI-compatible base URL; only change to point at a different
# OpenAI-protocol gateway.
AVALAI_BASE_URL=https://api.avalai.ir/v1
# No default — pick the model name from AvalAI's own catalogue.
AVALAI_MODEL=
AVALAI_TIMEOUT_SECONDS=30
AVALAI_MAX_TOKENS=4096

# ── Review history ────────────────────────────────────────────
# `word_reviews` is partitioned by month. Partitions do not appear on their
# own — run `make partitions` on a schedule (a daily cron is plenty).
# How many months of partitions to keep ahead of today. The margin is what
# stops a lapsed maintenance job from ever reaching the DEFAULT partition.
REVIEW_HISTORY_PARTITION_LOOKAHEAD_MONTHS=12
# How long raw review events are kept before their partition is dropped by
# `make partitions prune=1`. 0 keeps everything forever.
REVIEW_HISTORY_RETENTION_MONTHS=24
