{
  "permissions": {
    "allow": [
      "Bash(graphify export *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ali/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/ali/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}